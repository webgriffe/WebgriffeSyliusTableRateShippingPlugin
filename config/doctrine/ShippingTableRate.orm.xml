<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                  https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <mapped-superclass name="Webgriffe\SyliusTableRateShippingPlugin\Entity\ShippingTableRate" table="webgriffe_sylius_shipping_table_rate">
        <id name="id" type="integer">
            <generator strategy="AUTO"/>
        </id>
        <field name="code" unique="true"/>
        <field name="name"/>
        <field name="weightLimitToRate" type="json"/>
        <many-to-one field="currency" target-entity="Sylius\Component\Currency\Model\CurrencyInterface">
            <join-column name="currency_id" referenced-column-name="id" nullable="false"/>
        </many-to-one>
    </mapped-superclass>
</doctrine-mapping>
